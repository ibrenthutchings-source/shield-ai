# --- Environment ---
ENVIRONMENT=development

# --- Database (Postgres 16 + pgvector) ---
# Local docker-compose value shown; on Railway use the private DATABASE_URL
# from the Postgres plugin (postgresql+asyncpg://... via RAILWAY_PRIVATE_DOMAIN).
DATABASE_URL=postgresql+asyncpg://shieldai:shieldai@localhost:5432/shieldai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontier LLM providers (LangGraph orchestration) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Recon integrations ---
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
